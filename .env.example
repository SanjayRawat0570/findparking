PORT=8080
# If running MongoDB/Redis locally without Docker, use localhost addresses
MONGO_URI=mongodb://localhost:27017
MONGO_DB=parking
# Upstash: set REDIS_URL to the full URL (preferred) e.g.
# REDIS_URL=rediss://:<TOKEN>@us1-upstash-redis.upstash.io:6379
REDIS_URL=
REDIS_ADDR=localhost:6379
JWT_SECRET=supersecret
USE_COOKIE=0
